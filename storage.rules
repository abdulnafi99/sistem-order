rules_version = '2';
// Menu photos, logo, banner and DuitNow QR are public to read; only active staff may upload.
service firebase.storage {
  match /b/{bucket}/o {
    match /{folder}/{file} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.exists(/databases/(default)/documents/staff/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/staff/$(request.auth.uid)).data.active == true
        && folder in ['menu', 'branding', 'uploads']
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
